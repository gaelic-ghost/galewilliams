#extend("layout"):
    #export("body"):
        <section class="page-intro">
            <p class="eyebrow">#(page.eyebrow)</p>
            <h1>#(page.heading)</h1>
            <p class="summary">#(page.summary)</p>
        </section>

        <section class="choice-grid" aria-label="Service tracks">
            <a class="choice-panel" href="/services/personal">
                <span class="card-kicker">For you</span>
                <h2>Tools for your own work.</h2>
                <p>Automations, apps, and integrations for the systems you use every day.</p>
                <span class="panel-link">Explore personal services</span>
            </a>
            <a class="choice-panel" href="/services/business">
                <span class="card-kicker">For your team</span>
                <h2>Software for a growing business.</h2>
                <p>Workflows, internal tools, websites, and apps built around how your team works.</p>
                <span class="panel-link">Explore business services</span>
            </a>
        </section>

        <section class="text-band">
            <h2>Not sure where the idea fits?</h2>
            <p>Tell me what is getting in the way. We’ll work out the useful next step.</p>
            <div class="action-row compact">
                <a class="button primary" href="/contact">Start a project</a>
            </div>
        </section>
    #endexport
#endextend
