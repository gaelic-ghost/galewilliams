<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>#(chrome.title)</title>
    <meta name="description" content="#(chrome.description)">
    <meta name="robots" content="#(chrome.robotsDirective)">
    <link rel="canonical" href="#(chrome.canonicalURL)">
    <meta property="og:type" content="website">
    <meta property="og:title" content="#(chrome.title)">
    <meta property="og:description" content="#(chrome.description)">
    <meta property="og:url" content="#(chrome.canonicalURL)">
    <meta property="og:image" content="#(chrome.socialImageURL)">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="#(chrome.title)">
    <meta name="twitter:description" content="#(chrome.description)">
    <meta name="twitter:image" content="#(chrome.socialImageURL)">
    <link rel="icon" href="/images/sharp-icon.png" type="image/png">
    <link rel="stylesheet" href="/styles/site.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="scanline-shell">
        <header class="site-header">
            <a class="brand" href="/" aria-label="Gale Williams home">
                <img src="/images/sharp-icon.png" alt="" class="brand-mark">
                <span class="brand-name">Gale Williams</span>
            </a>
            <nav class="site-nav" aria-label="Primary navigation">
                #for(item in chrome.navItems):
                    <a href="#(item.path)" #if(item.isCurrent):aria-current="page"#endif>#(item.label)</a>
                #endfor
            </nav>
        </header>

        <main id="main-content" tabindex="-1">
            #import("body")
        </main>

        <footer class="site-footer">
            <span>Agentic apps, plugins, integrations, and Apple-platform software.</span>
            <div class="footer-links">
                <a href="/contact">Start a project</a>
                <a href="/sitemap">Sitemap</a>
            </div>
        </footer>
    </div>
</body>
</html>
