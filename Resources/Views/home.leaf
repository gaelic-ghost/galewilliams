#extend("layout"):
    #export("body"):
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">#(intro.eyebrow)</p>
                <h1>#(intro.heading)</h1>
                <p class="summary">#(intro.summary)</p>
                #extend("components/action-row")
            </div>
        </section>

        <section class="signal-grid" aria-label="Core work">
            <article>
                <span class="card-kicker">Agents</span>
                <h2>Practical agents for real workflows.</h2>
                <p>Clear inputs, approval points, and useful results.</p>
            </article>
            <article>
                <span class="card-kicker">Apps</span>
                <h2>Purpose-built apps tailored to you.</h2>
                <p>Software shaped around the job, platform, and people using it.</p>
            </article>
            <article>
                <span class="card-kicker">Integrations</span>
                <h2>Tools that work together.</h2>
                <p>Connect the systems you already rely on without unnecessary complexity.</p>
            </article>
        </section>
    #endexport
#endextend
