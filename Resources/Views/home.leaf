#extend("layout"):
    #export("body"):
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">#(intro.eyebrow)</p>
                <h1>#(intro.heading)</h1>
                <p class="summary">#(intro.summary)</p>
                #extend("components/action-row")
            </div>
        </section>

        <section class="signal-grid" aria-label="Core work">
            <article>
                <span class="card-kicker">iPhone and iPad</span>
                <h2>Native apps made for humans.</h2>
                <p>Fast, efficient, thoroughly polished.</p>
            </article>
            <article>
                <span class="card-kicker">Mac</span>
                <h2>Software that feels at home on macOS.</h2>
                <p>Apps, command-line tools, and background services.</p>
            </article>
            <article>
                <span class="card-kicker">Full-stack support</span>
                <h2>Everything your app depends on.</h2>
                <p>Swift backends, APIs, integrations, and web surfaces built to support the grandest of plans.</p>
            </article>
        </section>
    #endexport
#endextend
