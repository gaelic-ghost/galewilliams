#extend("layout"):
    #export("body"):
        <section class="page-intro compact-intro">
            <p class="eyebrow">Admin</p>
            <h1>#(lead.name)</h1>
            <p class="summary">#(lead.projectType) request from #(lead.email)</p>
        </section>

        <section class="admin-detail">
            <dl class="detail-grid">
                <div>
                    <dt>Status</dt>
                    <dd>#(lead.status)</dd>
                </div>
                <div>
                    <dt>Timeline</dt>
                    <dd>#(lead.timeline)</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd><a href="mailto:#(lead.email)">#(lead.email)</a></dd>
                </div>
                <div>
                    <dt>Project type</dt>
                    <dd>#(lead.projectType)</dd>
                </div>
            </dl>

            <article class="text-band admin-notes">
                <h2>Project Details</h2>
                <p>#(lead.details)</p>
            </article>

            #if(notification):
                <article class="text-band admin-notes">
                    <h2>Notification Delivery</h2>
                    <dl class="detail-grid">
                        <div>
                            <dt>Status</dt>
                            <dd>#(notification.status)</dd>
                        </div>
                        <div>
                            <dt>Attempts</dt>
                            <dd>#(notification.attemptCount)</dd>
                        </div>
                        <div>
                            <dt>Recipient</dt>
                            <dd>#(notification.recipient)</dd>
                        </div>
                        <div>
                            <dt>SES accepted at</dt>
                            <dd>#(notification.sentAt)</dd>
                        </div>
                    </dl>
                    #if(notification.failureReason):
                        <p>Latest delivery problem: #(notification.failureReason)</p>
                    #endif
                </article>
            #endif

            <div class="action-row compact">
                <a class="button" href="/admin/leads">Back to leads</a>
                #if(lead.canMarkReviewed):
                    <form class="inline-action" method="post" action="/admin/leads/#(lead.id)/review">
                        <input type="hidden" name="csrfToken" value="#(csrfToken)">
                        <button type="submit">Mark reviewed</button>
                    </form>
                #endif
            </div>
        </section>
    #endexport
#endextend
